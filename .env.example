# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# --- Accounts --------------------------------------------------------------------
# The site runs as a live demo only. 1 turns sign-up, sign-in and the password
# and email flows back on (they then need the email settings below).
PASSWORD_ACCOUNTS=0

# --- Email ---------------------------------------------------------------------
# Either Brevo's HTTPS API (needed where SMTP is blocked, e.g. Render's free plan):
# create a free account at brevo.com, verify your sender address, then create an
# API key under SMTP & API. It wins over SMTP when set.
BREVO_API_KEY=
# ... or Gmail over SMTP:
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put the address and the 16-character App Password below, then restart the backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# With neither set, mail is off: links then show on the page (outside production).

# Where the links in emails point.
APP_URL=http://localhost:5173

# development shows email links on the page when no mail server is set; production never does.
APP_ENV=development

# --- Developer access ----------------------------------------------------------
# Entered at sign-up (or on the Account page) for an instant, confirmed developer account.
DEVELOPER_ACCESS_CODE=

# --- Hosting (see docs/DEPLOY.md) ---------------------------------------------
# Browser origins allowed to call the API directly (comma-separated), and an
# optional regex for preview deployments, e.g. ^https://freightwise-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGIN_REGEX=
# Account store: SQLite at backend/var/app.db when empty; a Postgres URL in production.
AUTH_DB_URL=
# Session cookie: set COOKIE_SECURE=1 behind HTTPS. Lax works when the API is
# served from the web app's origin (the Vercel rewrite); use none only for two domains.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
